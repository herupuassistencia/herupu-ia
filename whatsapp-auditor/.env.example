# ==== Auditor de WhatsApp - HERUPU JARVIS ====
# Copie este arquivo para ".env" e preencha.
# A analise usa o CLAUDE CLI ja instalado (seu plano) -> SEM custo de OpenAI.

# SEU numero de WhatsApp (DDI + DDD + numero, so digitos) que vai RECEBER os alertas.
# Ex.: Brasil, celular 96 98415-3280  ->  5596984153280
AUDIT_TARGET=5596984153280

# Modelo do Claude (o mesmo do seu plano). Ex.: sonnet | opus
AUDIT_MODEL=sonnet

# Binario do Claude CLI. Normalmente 'claude'. Se nao achar, ponha o caminho completo,
# ex.: C:\Users\SEU_USUARIO\.local\bin\claude.exe
CLAUDE_BIN=claude

# Ignorar mensagens de GRUPOS? (true recomendado)
AUDIT_IGNORE_GROUPS=true

# Modo de operacao:
#   avisar    -> so te ALERTA com a sugestao (VOCE responde)  [RECOMENDADO]
#   responder -> responde SOZINHO no WhatsApp (use com muito cuidado)
AUDIT_MODE=avisar

# Varredura completa das conversas a cada N minutos (0 = so quando liga).
# Ex.: 30 = re-audita tudo a cada 30 min.
AUDIT_SWEEP_MIN=0

# Maximo de conversas detalhadas no relatorio de varredura.
AUDIT_MAX_ITENS=15

# Caminho do Chromium (SOMENTE em VPS Linux). No Windows deixe em branco.
# Ex.: /usr/bin/chromium-browser  ou  /usr/bin/google-chrome
CHROME_PATH=

# ==== VOZ: OUVIR os audios dos clientes (transcricao) ====
# STT_ENGINE: local | openai | auto | off
#   local  -> Whisper na propria maquina (GRATIS). Precisa whisper + ffmpeg. [ESCOLHIDO]
#   openai -> Whisper API (~centavos/min). Precisa OPENAI_API_KEY.
#   auto   -> usa openai se houver chave, senao local
#   off    -> nao transcreve audios
STT_ENGINE=local
# Whisper local: comando e modelo (tiny|base|small|medium). 'small' = bom equilibrio pt-BR.
WHISPER_BIN=whisper
WHISPER_MODEL=small
# Chave OpenAI: NAO e necessaria no modo local. So preencha se mudar STT_ENGINE=openai.
OPENAI_API_KEY=

# ==== VOZ: FALAR as solicitacoes em voz alta (como um secretario) ====
# VOZ_SAIDA: pc | off
#   pc  -> fala pela maquina (Windows: voz do sistema; Linux: espeak-ng)
#   off -> nao fala, so manda texto no WhatsApp
VOZ_SAIDA=pc
# (opcional) nome da voz do sistema no Windows, ex.: Microsoft Maria Desktop
VOZ_NOME=
