+                />
+              </div>
+            </div>
+          </div>
+
+          {/* RIGHT */}
+          <div className="bg-[#04110b]/45 border border-emerald-500/10 rounded-[28px] px-6 py-5 backdrop-blur-md shadow-[0_0_20px_rgba(0,255,120,0.04)]">
+            <div className="flex items-center justify-between">
+              {/* STATUS */}
+              <div>
+                <p className="text-gray-400 text-sm">STATUS</p>
+                <h3 className="text-emerald-400 text-xl font-black mt-1">SISTEMA ONLINE</h3>
+              </div>
+              {/* PERFIL */}
+              <div className="flex items-center gap-4">
+                <div className="text-right">
+                  <p className="text-white font-bold">{nomeUser}</p>
+                  <p className="text-emerald-400 text-sm capitalize">{perfilUser}</p>
+                </div>
+                <img
+                  src="./mascote-herupu.png"
+                  alt="IA"
+                  className="w-12 h-12 object-cover rounded-2xl border border-emerald-400/20 shadow-[0_0_15px_rgba(0,255,120,0.15)]"
+                />
+                {/* ALERTA SONORO DE OS NOVA */}
+                <AlertaSonoroOS />
+                {/* BOTÃO LOGOUT */}
+                <button
