+        {/* TOPBAR — computador */}
+        <div className="hidden lg:grid mb-8 grid-cols-1 xl:grid-cols-[1fr_420px] gap-5">
+
+          {/* LEFT */}
+          <div className="bg-[#04110b]/45 border border-emerald-500/10 rounded-[28px] px-8 py-6 backdrop-blur-md shadow-[0_0_20px_rgba(0,255,120,0.04)]">
+            <div className="flex items-center justify-between gap-6">
+              <div>
+                <h2 className="text-3xl font-black text-white leading-none">HERUPU</h2>
+                <p className="text-emerald-400 mt-1.5 text-sm tracking-widest">COMMAND CENTER</p>
+              </div>
+              {/* SEARCH */}
+              <div className="flex-1 max-w-[420px]">
+                <input
+                  type="text"
