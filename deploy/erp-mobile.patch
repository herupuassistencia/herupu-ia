+        </div>
+      </aside>
+
+      {/* CONTEÚDO */}
+      <main className="relative z-10 flex-1 min-w-0 p-3 sm:p-5 lg:p-8 overflow-y-auto">
+
+        {/* TOPO COMPACTO — celular */}
+        <div className="lg:hidden sticky top-0 z-20 -mx-3 -mt-3 sm:-mx-5 sm:-mt-5 mb-4 px-3 py-2.5 flex items-center gap-3 bg-[#020b07]/90 backdrop-blur-xl border-b border-emerald-500/10">
+          <button
+            onClick={() => setMenuAberto(true)}
