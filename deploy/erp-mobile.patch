+            aria-label="Abrir menu"
+          >
+            <Menu size={22} />
+          </button>
+          <img src="./logo-herupu.png" alt="" className="w-8" />
+          <div className="flex-1 min-w-0">
+            <p className="text-white font-black leading-none">HERUPU</p>
+            <p className="text-emerald-400 text-[11px] truncate capitalize">{perfilUser} · {nomeUser.split(" ")[0]}</p>
+          </div>
+          <AlertaSonoroOS />
+          <button
+            onClick={logout}
